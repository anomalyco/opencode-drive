{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opencode-lab-catalog",
  "account_id": "d8e944f537ceef3f06a5bd3aec1d7a53",
  "main": "worker.ts",
  "compatibility_date": "2026-08-12",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
  },
  "routes": [
    {
      "pattern": "dev.opencode.ai/lab/catalog",
      "zone_name": "dev.opencode.ai",
    },
    {
      "pattern": "dev.opencode.ai/lab/catalog/*",
      "zone_name": "dev.opencode.ai",
    },
  ],
}
